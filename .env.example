# composer setup copies this file to .env and fills in APP_KEY.
# The gateway starts with these values as they are.

APP_NAME=Gateway
# gateway:reset runs only when this is local.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The address Claude and the approval card reach the gateway on. Set it to the
# tunnel URL (https://<machine>.<tailnet>.ts.net) before you connect Claude,
# then restart composer dev.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite in database/database.sqlite. Sessions and cache are files, and the
# queue runs in the request.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Odoo. ODOO_PORT is the port compose.yaml publishes Odoo on, and ODOO_URL is
# where the gateway calls it. Change both together.
ODOO_PORT=8070
ODOO_URL=http://localhost:8070
# The API keys bin/odoo writes after each seed.
ODOO_KEYS_FILE=odoo/data/inbound-users.json

# The directory of .eml files the agent reads. Point it at the messages of the
# case that gateway:reset loaded.
GATEWAY_MAILBOX_PATH=cases/demo/demo-mailbox/messages
# A fixed date (YYYY-MM-DD) for a case whose story happens on another day.
# Empty means the real date.
GATEWAY_TODAY=
GATEWAY_TIMEZONE=Europe/Helsinki
# With false, no rule applies a change and every proposal waits for the user.
GATEWAY_RULE_TIER=true
GATEWAY_PROCESS=inbound-purchasing
# How long a card in the chat may decide.
GATEWAY_CARD_TOKEN_HOURS=12

# The one user everything runs as, and the Odoo login whose API key is used.
GATEWAY_USER_NAME="Riku Lindgren"
GATEWAY_USER_ROLE="supply chain lead"
GATEWAY_USER_ODOO_LOGIN=riku

# Comma-separated origins allowed to call /mcp. Add claude.ai's origin here if
# its calls come back 403.
MCP_ALLOWED_ORIGINS=

GATEWAY_MAILBOX_AUTHSERV_ID=mx.vuoksigolf.example
